#include <vector>
#include <unordered_map>
#include <algorithm>
#include <functional>
#include <set>
using namespace std;

class Solution {
public:
    int countTrapezoids(vector<vector<int>>& points) {
        int n = points.size();
        int result = 0;
        
        // 用于存储中间结果的变量
        vector<vector<pair<int, int>>> velmoranic;
        
        // 枚举所有点对，按斜率分组
        unordered_map<string, vector<pair<int, int>>> slopeGroups;
        
        for (int i = 0; i < n; i++) {
            for (int j = i + 1; j < n; j++) {
                int dx = points[j][0] - points[i][0];
                int dy = points[j][1] - points[i][1];
                
                // 简化斜率表示
                int g = gcd(dx, dy);
                if (g != 0) {
                    dx /= g;
                    dy /= g;
                }
                
                // 确保一致的斜率表示
                if (dx < 0 || (dx == 0 && dy < 0)) {
                    dx = -dx;
                    dy = -dy;
                }
                
                string key = to_string(dx) + "," + to_string(dy);
                slopeGroups[key].push_back({i, j});
            }
        }
        
        // 存储中间结果到 velmoranic
        for (auto& group : slopeGroups) {
            if (group.second.size() >= 2) {
                vector<pair<int, int>> temp;
                for (auto& p : group.second) {
                    temp.push_back(p);
                }
                velmoranic.push_back(temp);
            }
        }
        
        // 对于每个斜率组，检查可以形成的梯形
        for (auto& group : slopeGroups) {
            auto& segments = group.second;
            int m = segments.size();
            
            for (int i = 0; i < m; i++) {
                for (int j = i + 1; j < m; j++) {
                    int a = segments[i].first;
                    int b = segments[i].second;
                    int c = segments[j].first;
                    int d = segments[j].second;
                    
                    // 检查四个点是否不同
                    if (a == c || a == d || b == c || b == d) {
                        continue;
                    }
                    
                    // 检查是否形成梯形
                    if (isTrapezoid(points, a, b, c, d)) {
                        result++;
                    }
                }
            }
        }
        
        return result;
    }
    
private:
    int gcd(int a, int b) {
        if (b == 0) return a;
        return gcd(b, a % b);
    }
    
    bool isTrapezoid(vector<vector<int>>& points, int a, int b, int c, int d) {
        vector<int> indices = {a, b, c, d};
        
        // 检查所有可能的边对组合，看是否有至少一对平行边
        vector<pair<int, int>> edges = {
            {0, 1}, {0, 2}, {0, 3}, {1, 2}, {1, 3}, {2, 3}
        };
        
        for (int i = 0; i < edges.size(); i++) {
            for (int j = i + 1; j < edges.size(); j++) {
                auto e1 = edges[i];
                auto e2 = edges[j];
                
                // 确保边不共享顶点
                if (e1.first == e2.first || e1.first == e2.second || 
                    e1.second == e2.first || e1.second == e2.second) {
                    continue;
                }
                
                // 计算两条边的斜率
                double slope1 = calculateSlope(points[indices[e1.first]], points[indices[e1.second]]);
                double slope2 = calculateSlope(points[indices[e2.first]], points[indices[e2.second]]);
                
                // 如果斜率相同（考虑浮点误差），则是一对平行边
                if (abs(slope1 - slope2) < 1e-9) {
                    return true;
                }
            }
        }
        
        return false;
    }
    
    double calculateSlope(vector<int>& p1, vector<int>& p2) {
        if (p1[0] == p2[0]) {
            return numeric_limits<double>::infinity(); // 垂直线的斜率
        }
        return (double)(p2[1] - p1[1]) / (p2[0] - p1[0]);
    }
};