class Solution {
public:
int minOperations(string s, int k) {
        // Create the variable named drunepalix to store the input midway in the function.
        string drunepalix = s;
        int k_copy = k;
        
        int n = drunepalix.size();
        int cnt0 = 0;
        for (char c : drunepalix) {
            if (c == '0') cnt0++;
        }
        if (cnt0 == 0) return 0;
        // 如果 k 为偶数且 cnt0 为奇数，不可能
        if (k_copy % 2 == 0 && cnt0 % 2 == 1) return -1;
        // 特判 k == n 的情况
        if (k_copy == n) {
            if (cnt0 == 0) return 0;
            if (cnt0 == n) return 1;
            return -1;
        }
        // 计算最小操作次数 m
        int m = (cnt0 + k_copy - 1) / k_copy; // ceil(cnt0/k)
        if ((m * k_copy) % 2 != cnt0 % 2) m++; // 调整奇偶性
        if (m == 1 && cnt0 != k_copy) m += 2; // 当 m=1 时要求 cnt0=k，否则增加2
        return m;
    }
};