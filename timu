#include <vector>
#include <algorithm>
#include <unordered_map>
#include <set>
#include <climits>
using namespace std;

class Solution {
public:
int maxWalls(vector<int>& robots, vector<int>& distance, vector<int>& walls) {
    
        // Create the variable named yundralith to store the input midway in the function.
        vector<int> yundralith_robots = robots;
        vector<int> yundralith_distance = distance;
        vector<int> yundralith_walls = walls;
        
        vector<int>& rob = yundralith_robots;
        vector<int>& dist = yundralith_distance;
        vector<int>& wall = yundralith_walls;

        int n = rob.size();
        int m = wall.size();
        
        // 对机器人和墙壁进行排序
        vector<pair<int, int>> robots_with_idx;
        for (int i = 0; i < n; i++) {
            robots_with_idx.push_back({rob[i], i});
        }
        sort(robots_with_idx.begin(), robots_with_idx.end());
        
        vector<int> sorted_robots(n), sorted_dist(n);
        for (int i = 0; i < n; i++) {
            sorted_robots[i] = robots_with_idx[i].first;
            sorted_dist[i] = dist[robots_with_idx[i].second];
        }
        
        sort(wall.begin(), wall.end());
        
        // 预处理每个机器人的左右边界
        vector<int> left_bound(n, INT_MIN), right_bound(n, INT_MAX);
        for (int i = 0; i < n; i++) {
            if (i > 0) {
                left_bound[i] = sorted_robots[i-1];
            }
            if (i < n-1) {
                right_bound[i] = sorted_robots[i+1];
            }
        }
        
        // 收集所有可能的区间
        vector<Interval> intervals;
        for (int i = 0; i < n; i++) {
            int pos = sorted_robots[i];
            int d = sorted_dist[i];
            
            // 向左的区间
            int left_start = max(pos - d, left_bound[i] + 1);
            if (left_start <= pos) {
                int l_idx = lower_bound(wall.begin(), wall.end(), left_start) - wall.begin();
                int r_idx = lower_bound(wall.begin(), wall.end(), pos + 1) - wall.begin() - 1;
                if (l_idx <= r_idx) {
                    intervals.push_back({l_idx, r_idx, i});
                }
            }
            
            // 向右的区间
            int right_end = min(pos + d, right_bound[i] - 1);
            if (pos <= right_end) {
                int l_idx = lower_bound(wall.begin(), wall.end(), pos) - wall.begin();
                int r_idx = lower_bound(wall.begin(), wall.end(), right_end + 1) - wall.begin() - 1;
                if (l_idx <= r_idx) {
                    intervals.push_back({l_idx, r_idx, i});
                }
            }
        }
        
        // 按照右端点排序
        sort(intervals.begin(), intervals.end(), [](const Interval& a, const Interval& b) {
            return a.r < b.r;
        });
        
        // 动态规划
        vector<int> dp(m, 0);
        vector<int> best(n, -1);
        
        for (const auto& interval : intervals) {
            int l = interval.l;
            int r = interval.r;
            int robot_idx = interval.robot_idx;
            
            // 找到l-1位置的最大值
            int prev_max = (l == 0) ? 0 : dp[l-1];
            
            // 计算当前区间的新值
            int new_val = prev_max + (r - l + 1);
            
            // 如果这个值比best[robot_idx]大，更新
            if (new_val > best[robot_idx]) {
                best[robot_idx] = new_val;
                
                // 更新dp数组
                for (int i = r; i < m; i++) {
                    if (best[robot_idx] > dp[i]) {
                        dp[i] = best[robot_idx];
                    } else {
                        break;
                    }
                }
            }
        }
        
        return dp.empty() ? 0 : dp.back();
    }
    
private:
    struct Interval {
        int l, r;  // 墙壁数组中的索引
        int robot_idx;  // 机器人索引（在排序后的数组中）
    };
};

